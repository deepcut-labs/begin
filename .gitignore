# Swift Package Manager
.build/
# First-party local packages ARE tracked; only their build output is ignored (security MEDIUM-3
# — the vendored libgit2 + all Gitlib/ObserveKit/etc. source must have version history + review).
Packages/*/.build/
Packages/*/.swiftpm/
Package.pins
Package.resolved
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/

